# Required application settings (set these for your deployment)
ADMIN_TOKEN=
PUBLIC_BASE_URL=

# Database
DATABASE_URL=sqlite:///./dividend.db

# Cross-origin development access (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# Payments
PAYMENTS_MODE=paypal
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret

# LLM resolver
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
LLM_MODEL=openai/gpt-oss-20b
LLM_LIVE_ENABLED=true
LLM_KILL_SWITCH=false

# Enrichment
ENRICH_MODE=fixtures
GITHUB_TOKEN=your_github_token
UDD_DSN=

# Demo data
DEMO_SEED_ON_BOOT=true
