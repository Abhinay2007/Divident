# Safe local development defaults
ADMIN_TOKEN=local-only-token
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Database
DATABASE_URL=sqlite:///./data/dividend.db

# Cross-origin development access (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# Payments
# Local manual testing uses PayPal Sandbox only.
PAYMENTS_MODE=paypal
PAYPAL_ENV=sandbox
# Set PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET from the Sandbox REST app.

# LLM resolver
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_LIVE_ENABLED=false
LLM_KILL_SWITCH=true
LLM_MAX_SOURCES_PER_SESSION=5
LLM_MAX_CALLS_PER_HOUR=100

# Enrichment
ENRICH_MODE=fixtures
GITHUB_TOKEN=
UDD_DSN=

# Maintainer identity claims (GitHub OAuth App; optional until configured)
# Register the callback as <PUBLIC_BASE_URL>/api/maintainer-claims/oauth/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# Demo data
DEMO_SEED_ON_BOOT=true
