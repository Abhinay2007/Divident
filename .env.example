# Safe local development defaults
ADMIN_TOKEN=local-only-token
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Database
DATABASE_URL=sqlite:///./data/dividend.db

# Cross-origin development access (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# Payments
# Fake payments are the local default. PayPal is Sandbox only and currently
# cannot start until data/allocation_policy.yaml has measured fee parameters.
PAYMENTS_MODE=fake
PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# LLM resolver
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_LIVE_ENABLED=false
LLM_KILL_SWITCH=true
LLM_MAX_SOURCES_PER_SESSION=5
LLM_MAX_CALLS_PER_HOUR=100

# Enrichment
ENRICH_MODE=fixtures
GITHUB_TOKEN=
UDD_DSN=

# Demo data
DEMO_SEED_ON_BOOT=true
